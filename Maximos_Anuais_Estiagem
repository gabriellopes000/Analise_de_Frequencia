# Máximos de estiagem (abr-set) por duração (1, 2, 3...30 dias),
# que é a série que vai alimentar a análise de frequência
write_xlsx(
  maximos_estiagem,
  file.path(pasta_saida, paste0("maximos_estiagem_", estacao_label, ".xlsx"))
)
