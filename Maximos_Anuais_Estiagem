# =============================================================================
# 7. VALORES ACUMULADOS (ROLLING SUM) - 2, 3, 5, 7, 10, 15, 20, 30 DIAS
# =============================================================================

janelas <- c(2, 3, 5, 7, 10, 15, 20, 30)

data_acumulados <- data_consistido %>%
  group_by(station_code) %>%
  arrange(date, .by_group = TRUE) %>%
  mutate(
    across(
      .cols = "value",
      .fns  = setNames(
        lapply(janelas, function(n) {
          function(x) rollapplyr(x, width = n, FUN = sum, na.rm = TRUE, fill = NA)
        }),
        paste0("acum_", janelas, "d")
      )
    )
  ) %>%
  ungroup()

head(data_acumulados)

# =============================================================================
# 7b. MÁXIMOS NO PERÍODO DE ESTIAGEM (abr-set)
# =============================================================================

library(dplyr)

mes_inicio_estiagem <- 4  # abril
mes_fim_estiagem    <- 9  # setembro

maximos_estiagem <- data_acumulados %>%
  filter(as.character(variable) == "rainfall") %>%
  mutate(mes = as.integer(format(date, "%m")),
         ano = as.integer(format(date, "%Y"))) %>%
  filter(mes >= mes_inicio_estiagem & mes <= mes_fim_estiagem) %>%
  group_by(station_code, ano) %>%
  summarise(
    season_start_date = as.Date(sprintf("%04d-%02d-01", ano[1], mes_inicio_estiagem)),
    season_end_date   = as.Date(sprintf("%04d-%02d-01", ano[1], mes_fim_estiagem + 1)) - 1,
    max_1d   = max(value,             na.rm = TRUE),
    max_2d   = max(value_acum_2d,     na.rm = TRUE),
    max_3d   = max(value_acum_3d,     na.rm = TRUE),
    max_5d   = max(value_acum_5d,     na.rm = TRUE),
    max_7d   = max(value_acum_7d,     na.rm = TRUE),
    max_10d  = max(value_acum_10d,    na.rm = TRUE),
    max_15d  = max(value_acum_15d,    na.rm = TRUE),
    max_20d  = max(value_acum_20d,    na.rm = TRUE),
    max_30d  = max(value_acum_30d,    na.rm = TRUE),
    .groups = "drop"
  )

maximos_estiagem

# =============================================================================
# 8. EXPORTAR GRÁFICOS E TABELA FINAL
# =============================================================================
salvar_grafico <- function(plot_obj, nome_arquivo, largura = 10, altura = 6) {
  ggsave(
    filename = file.path(pasta_saida, nome_arquivo),
    plot     = plot_obj,
    width    = largura,
    height   = altura,
    dpi      = 300
  )
}

salvar_grafico(p_disponibilidade_bruta,      paste0("disponibilidade_bruta_", estacao_label, ".png"))
salvar_grafico(p_disponibilidade_consistida, paste0("disponibilidade_consistida_", estacao_label, ".png"))
salvar_grafico(p_climatologia,               paste0("climatologia_mensal_", estacao_label, ".png"), altura = 5)

