server <- function(input, output, session) {
  
  dados_iniciais <- data.frame(
    TR   = c(2, 5, 10, 20, 25, 50, 100, 200, 500, 1000, 10000),
    P24h = c(97.9, 124.5, 142.1, 159.0, 164.3, 180.8, 197.2, 213.5, 235.1, 251.3, 305.4)
  )
  
  output$tabela_input <- renderRHandsontable({
    rhandsontable(dados_iniciais, rowHeaders = FALSE) %>%
      hot_cols(colWidths = 100)
  })
  
  resultado_reativo <- eventReactive(input$calcular, {
    tabela <- hot_to_r(input$tabela_input)
    torrico_desagregacao(isozona = input$isozona, TR = tabela$TR, P24h = tabela$P24h)
  })
  
  output$tabela_saida <- renderRHandsontable({
    req(resultado_reativo())
    df <- formatar_df_largo(resultado_reativo())
    rhandsontable(df, rowHeaders = FALSE) %>%
      hot_cols(colWidths = 80) %>%
      hot_table(highlightCol = TRUE, highlightRow = TRUE)
  })
  
  output$grafico_idf <- renderPlot({
    req(resultado_reativo())
    plotar_idf(resultado_reativo())
  })
}

shinyApp(ui, server)
