calcula_fator_morbidelli <- function(ta, d) {
  # ta: resolução temporal da medição (mesma unidade de d)
  # d : duração de interesse (mesma unidade de ta)
  razao  <- ta / d
  Ea_pct <- 5.2 * razao^2 + 5.57 * razao
  fator  <- 1 / (1 - Ea_pct / 100)
  return(list(razao = razao, Ea_pct = Ea_pct, fator = fator))
}

