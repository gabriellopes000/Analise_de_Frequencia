verificar_consistencia_duracoes <- function(dados, ordem_duracoes) {
  inconsistencias <- list()
  
  for (i in seq_len(nrow(dados))) {
    valores <- as.numeric(dados[i, ordem_duracoes])
    
    for (j in 2:length(valores)) {
      if (valores[j] < valores[j - 1]) {
        inconsistencias[[length(inconsistencias) + 1]] <- data.frame(
          ano          = dados$ano[i],
          duracao_menor = ordem_duracoes[j - 1],
          duracao_maior = ordem_duracoes[j],
          valor_menor   = valores[j - 1],
          valor_maior   = valores[j]
        )
      }
    }
  }
  
  if (length(inconsistencias) > 0) do.call(rbind, inconsistencias) else NULL
}

