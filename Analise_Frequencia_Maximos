verificar_instalar_pacotes <- function(pacotes_cran = character(),
                                       pacotes_github = list()) {
  # pacotes_github: lista nomeada, ex. list(ALEA = "hydrostat/ALEA")
  
  # --- Pacotes do CRAN ---
  for (pacote in pacotes_cran) {
    if (!requireNamespace(pacote, quietly = TRUE)) {
      message("Instalando pacote (CRAN): ", pacote)
      install.packages(pacote)
    }
    library(pacote, character.only = TRUE)
  }
  
  # --- Pacotes do GitHub ---
  if (length(pacotes_github) > 0 && !requireNamespace("remotes", quietly = TRUE)) {
    install.packages("remotes")
  }
  
  for (nome in names(pacotes_github)) {
    if (!requireNamespace(nome, quietly = TRUE)) {
      message("Instalando pacote (GitHub): ", nome, " <- ", pacotes_github[[nome]])
      remotes::install_github(pacotes_github[[nome]])
    }
    library(nome, character.only = TRUE)
  }
  
  invisible(TRUE)
}

