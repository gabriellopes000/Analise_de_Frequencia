extrair_fit_manual <- function(fits_max, dur, distribuicao, metodo) {
  # resolve valor único ou nomeado por duração
  dist_dur <- if (length(distribuicao) > 1) distribuicao[[dur]] else distribuicao
  met_dur  <- if (length(metodo) > 1) metodo[[dur]] else metodo
  
  fit_tabela <- as.data.frame(fits_max[[dur]])
  idx <- which(fit_tabela$distribution == dist_dur & fit_tabela$method == met_dur)
  
  if (length(idx) == 0) {
    stop("Combinação '", dist_dur, "' / '", met_dur, "' não encontrada em ", dur, ".")
  }
  
  fits_max[[dur]]$fit_objects[[fit_tabela$fit_index[idx]]]
}

