plot_quantis_selecionado <- function(fit_compare, return_period,
                                     distribuicoes = NULL, metodos = NULL,
                                     titulo = NULL, subtitulo = NULL,
                                     tamanho_pontos = 2.5) {
  q <- alea_quantile(fit_compare, return_period = return_period)
  p_base <- plot(q, plot_observed = TRUE)
  
  dados_plot <- p_base$data
  dados_plot$distribution <- toupper(dados_plot$distribution)
  dados_plot$method <- toupper(dados_plot$method)
  
  # aplica os filtros, se informados
  if (!is.null(distribuicoes)) {
    dados_plot <- dados_plot[dados_plot$distribution %in% toupper(distribuicoes), ]
  }
  if (!is.null(metodos)) {
    dados_plot <- dados_plot[dados_plot$method %in% toupper(metodos), ]
  }
  
  if (nrow(dados_plot) == 0) {
