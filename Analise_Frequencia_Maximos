plot_quantis_selecionado <- function(fit_compare, return_period,
                                     distribuicoes = NULL, metodos = NULL,
                                     titulo = NULL, subtitulo = NULL,
                                     tamanho_pontos = 2.5,
                                     espessura_linha = 0.5) {
  q <- alea_quantile(fit_compare, return_period = return_period)
  p_base <- plot(q, plot_observed = TRUE)
  
  dados_plot <- p_base$data
  dados_plot$distribution <- toupper(dados_plot$distribution)
  dados_plot$method <- toupper(dados_plot$method)
  
  if (!is.null(distribuicoes)) dados_plot <- dados_plot[dados_plot$distribution %in% toupper(distribuicoes), ]
  if (!is.null(metodos)) dados_plot <- dados_plot[dados_plot$method %in% toupper(metodos), ]
  
  if (nrow(dados_plot) == 0) {
    stop("Nenhum modelo encontrado para a combinação de distribuição/método informada.")
  }
  
  ticks <- unique(p_base$data[, c("return_period", "return_period_axis")])
  ticks <- ticks[order(ticks$return_period), ]
  
  dados_observados <- if (length(p_base$layers) > 1) p_base$layers[[2]]$data else NULL
  
  p <- ggplot(
    dados_plot,
    aes(
      x = return_period_axis, y = quantile,
      color = distribution, linetype = method, group = model_label
    )
  ) +
    geom_line(linewidth = espessura_linha)
  
  if (!is.null(dados_observados) && nrow(dados_observados) > 0) {
    p <- p +
      geom_point(
        data = dados_observados,
        aes(x = return_period_axis, y = quantile),
        inherit.aes = FALSE,
        shape = 21,
        size = tamanho_pontos,
        stroke = 0.8,
        color = "#2C3E50",
        fill = "white",
        alpha = 0.9
      )
  }
  
  p +
    scale_color_manual(values = cores_distribuicao, name = "Distribuição") +
    scale_linetype_manual(values = linetypes_metodo, name = "Método") +
    scale_x_continuous(breaks = ticks$return_period_axis, labels = ticks$return_period) +
    labs(title = titulo, subtitle = subtitulo, x = "Tempo de retorno (anos)", y = "Quantil (mm)") +
    theme_bw(base_size = 11) +
    theme(panel.grid.minor = element_blank())
}

