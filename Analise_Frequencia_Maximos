ks_bootstrap_test <- function(fit, n_boot = 500, seed = NULL) {
  if (!is.null(seed)) set.seed(seed)
  
  n <- length(fit$data)
  distribution <- fit$distribution
  method <- fit$method
  
  d_obs <- as.data.frame(alea_gof(fit, statistics = "ks"))$estimate
  
  d_boot <- numeric(n_boot)
  
  for (b in seq_len(n_boot)) {
    # amostra sintética a partir da própria distribuição ajustada (inversão da CDF)
    u  <- runif(n, min = 1e-6, max = 1 - 1e-6)
    tr <- 1 / (1 - u)
    x_sim <- alea_quantile(fit, return_period = tr)$quantile
    
    # reajusta o modelo à amostra sintética (essencial p/ validade do teste)
    fit_sim <- tryCatch(
      alea_fit(x_sim, distribution = distribution, method = method),
      error = function(e) NULL
    )
    
    d_boot[b] <- if (is.null(fit_sim)) {
      NA_real_
    } else {
      as.data.frame(alea_gof(fit_sim, statistics = "ks"))$estimate
    }
  }
  
  d_boot <- d_boot[is.finite(d_boot)]
  
  list(
    d_obs = d_obs,
    p_value = mean(d_boot >= d_obs),
    n_boot_sucesso = length(d_boot)
  )
}

